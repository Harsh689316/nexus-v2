# NEXUS hosted authentication configuration
PORT=4000

# PostgreSQL / PERN
DATABASE_URL=postgresql://nexus:nexus_dev_password@localhost:5432/nexus
DATABASE_SSL=false

# Authorized CCTNS/ICJS connector (leave blank for synthetic demo mode)
CCTNS_BASE_URL=
CCTNS_API_KEY=
VITE_API_ORIGIN=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000
RP_ID=localhost

# Server-side officer credentials. Replace every placeholder locally. Never commit populated env files.
NEXUS_NEXUS_ADMIN_01_PASSWORD=replace-with-strong-secret
NEXUS_NEXUS_ADMIN_01_RECOVERY_CODE=replace-with-strong-recovery-secret
NEXUS_INS_1042_PASSWORD=replace-with-strong-secret
NEXUS_INS_1042_RECOVERY_CODE=replace-with-strong-recovery-secret
NEXUS_SI_2087_PASSWORD=replace-with-strong-secret
NEXUS_SI_2087_RECOVERY_CODE=replace-with-strong-recovery-secret
NEXUS_ACP_4022_PASSWORD=replace-with-strong-secret
NEXUS_ACP_4022_RECOVERY_CODE=replace-with-strong-recovery-secret
NEXUS_SP_5027_PASSWORD=replace-with-strong-secret
NEXUS_SP_5027_RECOVERY_CODE=replace-with-strong-recovery-secret
NEXUS_DCP_6033_PASSWORD=replace-with-strong-secret
NEXUS_DCP_6033_RECOVERY_CODE=replace-with-strong-recovery-secret
NEXUS_DIG_7044_PASSWORD=replace-with-strong-secret
NEXUS_DIG_7044_RECOVERY_CODE=replace-with-strong-recovery-secret
NEXUS_IG_8055_PASSWORD=replace-with-strong-secret
