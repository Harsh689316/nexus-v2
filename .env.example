RESEND_API_KEY=replace-with-provider-secret
RECOVERY_FROM_EMAIL=NEXUS Security <security@your-verified-domain.example.com>
RECOVERY_EMAIL_DGP_1007=officer@example.com
RECOVERY_EMAIL_DIG_7044=officer@example.com
